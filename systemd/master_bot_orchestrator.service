[Unit]
Description=Master Bot Orchestrator
After=network.target bot_c_okx_swap.service
Wants=bot_c_okx_swap.service

[Service]
Type=simple
WorkingDirectory=/home/hongsoonil02/quant_system
ExecStart=/usr/bin/python3 /home/hongsoonil02/quant_system/master_bot_orchestrator.py
Restart=on-failure
RestartSec=10
EnvironmentFile=-/home/hongsoonil02/quant_system/.env
Environment="PYTHONUNBUFFERED=1"
StandardOutput=append:/home/hongsoonil02/quant_system/master_orchestrator.log
StandardError=append:/home/hongsoonil02/quant_system/master_orchestrator.log

[Install]
WantedBy=default.target
