[Unit]
Description=Daily Trading Analyzer and Auto-Tuner
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/hongsoonil02/quant_system
ExecStart=/usr/bin/python3 /home/hongsoonil02/quant_system/daily_analyzer.py
EnvironmentFile=-/home/hongsoonil02/quant_system/.env
StandardOutput=append:/home/hongsoonil02/quant_system/daily_analyzer.log
StandardError=append:/home/hongsoonil02/quant_system/daily_analyzer.log

[Install]
WantedBy=default.target
